{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Трекер расходов: Next.js + NestJS + Prisma + PostgreSQL",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @expense-tracker/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @expense-tracker/api exec prisma generate",
    "db:studio": "pnpm --filter @expense-tracker/api exec prisma studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "~6.0.3"
  }
}
