// Схема-заготовка трекера расходов.
// Миграции ещё не создавались: после `pnpm install` и `pnpm db:up`
// первый прогон — `pnpm db:migrate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// В Prisma 7 датасорс больше не содержит url — строка подключения для CLI
// (migrate, studio) задаётся в ../prisma.config.ts, а рантайм-клиент
// получает её через драйвер-адаптер в PrismaService.
datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  // argon2id-хеш пароля. Записывается только обработчиком CreateUserCommand.
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Category {
  id     String          @id @default(uuid()) @db.Uuid
  userId String          @db.Uuid
  name   String
  type   TransactionType
  icon   String?
  color  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  // Категория необязательна: операцию можно завести до её разбора.
  categoryId String? @db.Uuid

  // Только Decimal. Float накапливает ошибку округления на суммах денег,
  // а @db.Decimal(12, 2) точно ложится на numeric(12,2) в PostgreSQL.
  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("USD") @db.VarChar(3)
  type     TransactionType
  date     DateTime        @db.Timestamptz(3)
  note     String?         @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Основной сценарий чтения — лента операций пользователя за период.
  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}
